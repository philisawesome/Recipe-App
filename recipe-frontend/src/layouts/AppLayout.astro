---
import "../styles/global.css";
import { ProfilePic } from "../components/avatar-card"
import { SearchWithAutocomplete } from "../components/search"
import { Font } from "astro:assets";
import Navbar from "../pages/partials/navbar.astro"
---
<!DOCTYPE html>
<html>
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />		
		<title>Stovetop</title>
		<link rel="icon" type="image/svg" href="/egg.svg">
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com"/>
		<link href="https://fonts.googleapis.com/css2?family=Goudy+Bookletter+1911&family=Marck+Script&display=swap" rel="stylesheet"/>
		<script is:inline>
			document.documentElement.dataset.auth = localStorage.getItem('token') != null ? "true" : "false"
			document.documentElement.dataset.username = localStorage.getItem('username') 
		</script>
		<style is:inline>
			[data-auth-required="true"] {
			  display: none !important;
			}
			
			html[data-auth="true"] [data-auth-required="true"] {
			  display: block !important;
			}
			
			html[data-auth="true"] [data-auth-required="false"] {
			  display: none !important;
			}
			
			[data-auth-required="false"] {
			  display: block !important;
			}
  		</style>
		<Font cssVariable="--font-clemente" />
	</head>
	<body>
		{/* <SidebarWrapper client:load/> */}
		<div class="z-2 pt-6 md:pt-10 w-full px-0 md:px-5 md:w-[50rem]">
			<div class="fixed top-0 left-0 z-4 navbar w-screen flex items-center md:justify-center z-6">
				<img id="egg" class="mx-2" src="/egg.svg" width="35px"/>
				<a href="/" class="flex mr-2">
					<h1 class="title title-font text-center">Stovetop</h1>
				</a>

				<div class="hidden md:flex">
					<Navbar/>
				</div>

				<div data-auth-required="true">
					<a class="absolute h-full mr-2 top-0 right-0 flex justify-center items-center" id="username-link">
						<p class="text-white text-sm w-[6rem] text-right overflow-clip md:text-lg" id="username-text">yo</p>
						<ProfilePic data-username="hi" client:load/>
					</a>
				</div>
			</div>

			<div class="absolute left-0 top-0 py-3 w-full text-center flex flex-col gap-2 text-lg z-5 md:hidden" id="navbar-dropdown" client:load>
				<Navbar/>
			</div>

			<slot/>
		</div>
		<script is:inline>
			const user = document.getElementById('username-text')
			const userlink = document.getElementById('username-link')
			if (user) {
				const username = localStorage.getItem('username')
				user.textContent = username
				userlink.href = `/profile?user=${username}`
			}
		</script>
  	</body>
<script>
	import { loggedIn, logout, redirect } from "../components/auth-store"
	const logoutBtn = document.getElementById('logout')
	if (logoutBtn !== null) {
		logoutBtn.addEventListener('click', () => {
			logout()
		})
	}

	loggedIn.subscribe(a => {
		document.documentElement.setAttribute('data-auth', a ? 'true' : 'false')
	})

	redirect.subscribe((link) => {
		if (link != '') {
			redirect.set('')
			return window.location.replace(link);
		}
	})

	const navbarDrop = document.getElementById('navbar-dropdown')
	const eggToggleDrop = document.getElementById('egg')
	eggToggleDrop.addEventListener('click', () => {
		navbarDrop.classList.toggle('open')
	})
</script>
</html>
